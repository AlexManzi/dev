# Set this only for the production/static deployment build.
# Leave unset for local development.
NEXT_OUTPUT=export
# Set this to /repository-name for a GitHub Pages project site.
# Leave empty when deploying to a custom domain or username.github.io.
NEXT_BASE_PATH=

